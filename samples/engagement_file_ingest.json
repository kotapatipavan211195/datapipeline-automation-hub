{
  "spec_version": 3,
  "metadata": {
    "name": "engagement_file_ingest",
    "script_name": "mkt_engagement_ingest",
    "description": "Ingests the daily engagement files sent by the vendor: moves them from the vendor drop bucket to the landing folder, loads them to a staging table, keeps a history table, merges the newest record per client into the daily table and archives the files. Emails the team when no file arrives.",
    "owner": "pipeline.developer@example.com",
    "team": "Membership",
    "tags": [
      "ingestion",
      "vendor"
    ],
    "authors": [
      "P10000"
    ],
    "reviewers": [
      "P12345"
    ],
    "jira": "SN-4321",
    "created_on": "2025-12-10",
    "updates": [
      {
        "date": "2026-10-13",
        "pid": "P10000",
        "note": "Generated with the Datapipeline Automation Hub"
      }
    ]
  },
  "environments": {
    "qa_enabled": false
  },
  "variables": [
    {
      "name": "read_project",
      "group": "project",
      "values": {
        "lab": "value-confidential",
        "value": "value-gcp"
      }
    },
    {
      "name": "write_project",
      "group": "project",
      "values": {
        "lab": "demo-analytics-dev",
        "value": "value-gcp"
      }
    },
    {
      "name": "landing_bucket",
      "group": "bucket",
      "values": {
        "lab": "demo_file_test_bucket",
        "value": "value-gcp-insights"
      },
      "description": "where the process reads files"
    },
    {
      "name": "landing_path",
      "group": "other",
      "values": {
        "lab": "engagement_ingestion",
        "value": "inbound/engagement"
      }
    },
    {
      "name": "archive_path",
      "group": "other",
      "values": {
        "lab": "engagement_ingestion/Archive",
        "value": "Archive/inbound/engagement"
      }
    },
    {
      "name": "vendor_bucket",
      "group": "bucket",
      "values": {
        "lab": "demo_vendor_drop_test",
        "value": "value-gcp-vendor-drop"
      },
      "description": "vendor SFTP drop"
    },
    {
      "name": "temporary_dataset",
      "group": "dataset",
      "values": {
        "lab": "clubwide",
        "value": "discovery05"
      }
    },
    {
      "name": "target_dataset",
      "group": "dataset",
      "values": {
        "lab": "clubwide",
        "value": "strategic03"
      }
    }
  ],
  "secrets": [],
  "email": {
    "enabled": true,
    "receivers": {
      "lab": "pipeline.developer@example.com",
      "value": "pipeline.developer@example.com, analyst.one@example.com, analyst.two@example.com"
    },
    "send_on": {
      "failure": true,
      "success": false
    },
    "subject": "Engagement File Status | {status} | {environment}",
    "message": "The engagement file ingestion finished with status {status}.",
    "attachments": []
  },
  "steps": [
    {
      "type": "copy",
      "function_name": "move_vendor_files",
      "description": "Move today's engagement files from the vendor drop bucket to the landing folder",
      "operation": "mv",
      "sources": [
        "gs://{vendor_bucket}/outbound/Daily Engagement File_*.csv"
      ],
      "destination": "gs://{landing_bucket}/{landing_path}/",
      "no_clobber": true
    },
    {
      "type": "ingest",
      "function_name": "ingest_engagement_files",
      "description": "Load the engagement files into staging, history and the daily table, then archive them",
      "read_bucket": "{landing_bucket}",
      "read_path": "{landing_path}",
      "filename": "Daily Engagement File_",
      "file_format": "CSV",
      "header": "0",
      "skiprows": "None",
      "separator": ",",
      "columns": [
        {
          "name": "Created",
          "type": "DATETIME"
        },
        {
          "name": "Drip_Id",
          "type": "STRING"
        },
        {
          "name": "Client_Id",
          "type": "STRING"
        },
        {
          "name": "Phone",
          "type": "STRING"
        },
        {
          "name": "Project_Name",
          "type": "STRING"
        },
        {
          "name": "Campaign",
          "type": "STRING"
        },
        {
          "name": "Engaged",
          "type": "INTEGER"
        },
        {
          "name": "Last_Engaged_Time",
          "type": "DATETIME"
        },
        {
          "name": "Transfered",
          "type": "INTEGER"
        },
        {
          "name": "Last_Transfered_Time",
          "type": "DATETIME"
        },
        {
          "name": "Clicked",
          "type": "INTEGER"
        },
        {
          "name": "Last_Clicked_Time",
          "type": "STRING"
        },
        {
          "name": "Closed",
          "type": "INTEGER"
        },
        {
          "name": "Last_Closed_Time",
          "type": "DATETIME"
        },
        {
          "name": "Converted",
          "type": "INTEGER"
        },
        {
          "name": "Last_Converted_Time",
          "type": "DATETIME"
        },
        {
          "name": "Long_Call",
          "type": "INTEGER"
        },
        {
          "name": "Disqualified",
          "type": "INTEGER"
        },
        {
          "name": "DQ_Channel",
          "type": "STRING"
        },
        {
          "name": "DQ_Tier",
          "type": "INTEGER"
        },
        {
          "name": "Last_DQ_Time",
          "type": "DATETIME"
        }
      ],
      "table_name": "engagement",
      "target_table": "engagement_daily",
      "staging_dataset": "{temporary_dataset}",
      "target_dataset": "{target_dataset}",
      "history": true,
      "load_mode": "merge",
      "merge_keys": [
        "Client_Id"
      ],
      "merge_order_by": "Created",
      "merge_filter": "upper(Campaign) NOT LIKE '%UAT%'",
      "archive": true,
      "archive_path": "{archive_path}",
      "on_no_files": "email"
    },
    {
      "type": "dq",
      "function_name": "check_engagement_daily",
      "description": "Every client appears once in the daily table",
      "checks": [
        {
          "kind": "unique",
          "table": "{write_project}.clubwide.engagement_daily",
          "columns": [
            "Client_Id"
          ],
          "severity": "error"
        },
        {
          "kind": "not_null",
          "table": "{write_project}.clubwide.engagement_daily",
          "columns": [
            "Client_Id",
            "Created"
          ],
          "severity": "warn"
        }
      ]
    }
  ]
}